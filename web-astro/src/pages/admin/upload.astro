---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Log In">
  <h1>
    this site should be protected and if not loged in kick them out ADMIN SIDE
  </h1>

  <div>
    <button id="openBookModal"> upload book </button>
    <dialog id="bookModal">
      <div class="bookModalDivRoot" class="h-3/4 bg-gray-50 w-6/6">
        <h1>upload a new book</h1>
        <label>Name: <input id="bookName" /> </label>
        <label>Author: <input id="bookAuthor" /> </label>

        <select id="genres" multiple></select>
        <div class="flex felx-row w-4/4 h-4/4">
          <div>
            <label>Content: </label>
            <div id="bookDropZone" class="bg-blue-600 h-44 w-44"></div>
          </div>
          <div>
            <label>ThumbNail: </label>
            <div id="bookThumbnailDropZone" class="bg-red-600 h-44 w-44"></div>
          </div>
        </div>
        <div>
          <label>Price</label>
          <input type="number" id="bookPrice" />
        </div>
        <button id="closeBookModal"> close </button>
        <button id="submitBook"> save new book </button>
      </div>
    </dialog>
  </div>

  <div>
    <button id="openAudiobookModal"> upload audio book </button>
    <dialog id="audiobookModal" class="h-3/6 bg-gray-50">
      <div class="bookModalDivRoot" class="flex felx-row w-4/4 h-4/4">
        <h1>upload a new audio book</h1>
        <select id="audiobookLoBo"> </select>
        <label>Author: <input id="audiobookAuthor" /> </label>
        <div class="flex felx-row">
          <div>
            <label
              >Audio:
              <div id="audiobookDropZone" class="bg-blue-600 h-44 w-44"></div>
            </label>
          </div>
        </div>
        <select id="languageChoice">
          <option value="ENGLISH">ENGLISH</option>
          <option value="SPANISH">SPANISH</option>
        </select>
        <button id="closeAudiobookModal"> close </button>
        <button id="submitAudiobook"> save new audiobook </button>
      </div>
    </dialog>
  </div>

  <div>
    <button id="openSubsModal"> upload subs </button>
    <dialog id="subsModal" class="h-5/6 w-5/6">
      <div class="h-5/6 w-5/6 bg-gray-400">
        <div>
          <label
            >Subs:
            <div id="audioSubsDropzone" class="bg-red-600 h-44 w-44"></div>
          </label>
        </div>

        <select id="AudioBookChoice"> </select>
        <select id="languageChoiceSubs">
          <option value="ENGLISH">ENGLISH</option>
          <option value="SPANISH">SPANISH</option>
        </select>
        <br />
        <button id="closeSubsModal"> close </button>
        <button id="submitSubs"> submitsubs </button>
      </div>
    </dialog>
  </div>

  <div>
    <button id="openStreamModal"> upload stream </button>
    <dialog id="streamModal">
      <label>Id: <input id="streamId" /></label>
      <button id="closeStreamModal"> close </button>
      <button id="submitStream"> save new video </button>

      <select id="tagsSelect" multiple></select>
    </dialog>
  </div>

  <script>
    import { createAuthTrpc } from "../../utils/trpc";
    const trpc = createAuthTrpc()!;

    // stream stuff
    const openStreamModal = document.getElementById(
      "openStreamModal",
    ) as HTMLButtonElement;
    const streamModal = document.getElementById(
      "streamModal",
    ) as HTMLDialogElement;
    const closeStreamModal = document.getElementById(
      "closeStreamModal",
    ) as HTMLButtonElement;
    const submitStream = document.getElementById(
      "submitStream",
    ) as HTMLButtonElement;
    const streamId = document.getElementById("streamId") as HTMLInputElement;
    const tagsSelect = document.getElementById(
      "tagsSelect",
    ) as HTMLSelectElement;

    submitStream.onclick = async (e) => {
      e.preventDefault();
      try {
        const tagIds: string[] = [];
        for (let i = 0; i < tagsSelect.selectedOptions.length; i++) {
          tagIds.push(tagsSelect.selectedOptions[i].value);
        }
        console.log(tagIds);
        const a = await trpc.video.createNewVideo.mutate({
          id: streamId.value,
          tagIds: tagIds,
        });
        console.log(a);
      } catch (error) {
        console.log(`There was an error in admin/upload submitStream`, error);
      }
    };

    closeStreamModal.onclick = () => {
      streamModal.close();
    };

    openStreamModal.onclick = () => {
      streamModal.open = !streamModal.open;
    };

    // audio book stuff
    const main = async () => {
      try {
        const isAuth = await trpc.auth.authorizedAdmin.query();
        if (!isAuth) {
          console.log(isAuth);
          //window.location.replace("/");
        }

        const tags = await trpc.tags.getTags.query();

        tags.forEach((t) => {
          const option = document.createElement("option");
          option.value = t.id;
          option.textContent = t.name;

          tagsSelect.appendChild(option);
        });
      } catch (error) {
        console.log(`Error admin/upload.astro ${error}`);
        //window.location.replace("/");
      }
    };
    main();
  </script>
</Layout>

<style></style>
