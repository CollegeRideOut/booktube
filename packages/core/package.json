{
  "name": "@booktube/core",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "sst bind vitest",
    "migrations:generate": "drizzle-kit generate:mysql",
    "migrations:push": "node -r esbuild-register src/lib/db/migrate.ts",
    "db:push": "drizzle-kit push:mysql --config=drizzle.config.ts",
    "db:drop": "drizzle-kit drop",
    "studio": "drizzle-kit studio",
    "migrations:drop": "drizzle-kit drop --config=drizzle.config.ts",
    "typecheck": "tsc -noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/uuid": "^9.0.7",
    "drizzle-kit": "^0.20.13",
    "sst": "^2.39.7",
    "vitest": "^1.2.1"
  },
  "dependencies": {
    "@planetscale/database": "^1.14.0",
    "dotenv": "^16.3.2",
    "drizzle-orm": "^0.29.3",
    "mysql2": "^3.7.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  }
}
